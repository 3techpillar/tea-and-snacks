# Copy this file to .env and fill in real values for local development.

# MongoDB connection string. A local mongod works fine for the demo:
MONGODB_URI=mongodb://127.0.0.1:27017/easyfood

# ── JWT secrets ─────────────────────────────────────────────────────
# Separate secrets for access and refresh tokens.
# Generate real random values for production: openssl rand -hex 32

JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me

# Access tokens are short-lived; refresh tokens are long-lived.
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Frontend origin for CORS (must match the frontend dev server URL)
FRONTEND_URL=http://localhost:5173

# Server port
PORT=3001
