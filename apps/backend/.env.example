# Copy this file to .env and fill in real values for local development.

# MongoDB connection string. A local mongod works fine for the demo:
MONGODB_URI=mongodb://127.0.0.1:27017/easyfood

# Secret used to sign JWTs. Generate a real random value for anything beyond
# local dev, e.g.: openssl rand -hex 32
JWT_SECRET=dev-only-insecure-secret-change-me
JWT_EXPIRES_IN=7d

# Frontend origin for CORS (must match the frontend dev server URL)
FRONTEND_URL=http://localhost:5173

# Server port
PORT=3001
