# ── Backend Environment Variables ──
# (Note: In Docker, these are typically provided by the root .env)

# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/tea-snacks

# JWT secrets
JWT_ACCESS_SECRET=your_super_secret_access_key
JWT_REFRESH_SECRET=your_super_secret_refresh_key

# Token Lifespans
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Frontend origin for CORS
FRONTEND_URL=http://localhost:5173

# Server port
PORT=3015

# Email / SMTP Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=your_email@example.com
SMTP_PASS=your_email_password

# Firebase Service Account Path (Relative or Absolute)
# For local dev: ./service-account.json
# For Docker: /app/service-account.json
FIREBASE_SERVICE_ACCOUNT_PATH=./service-account.json
