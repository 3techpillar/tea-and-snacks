# ── Frontend Environment Variables ──
# Note: For Docker deployment, these MUST be present during `docker-compose build`

# API URL (Change to your production API URL, e.g., https://api.yourdomain.com)
VITE_API_URL=http://localhost:3015

# Firebase Frontend Configuration (Safe to be public)
VITE_FIREBASE_API_KEY=YOUR_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_AUTH_DOMAIN
VITE_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=YOUR_STORAGE_BUCKET
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_MESSAGING_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_APP_ID

# Firebase Web Push VAPID Key (For Notifications)
VITE_FIREBASE_VAPID_KEY=YOUR_VAPID_KEY
